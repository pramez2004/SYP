# Chaad Baad (चाडबाड) - Django Backend
# ======================================
# Copy this file to .env and update values

# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=chaadbaad
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS - React Native / Expo dev
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Media & Static
MEDIA_URL=/media/
STATIC_URL=/static/
